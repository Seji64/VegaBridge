@page "/"

@using VegaBridgeApp.Models.Routes
@using VegaBridgeApp.Services.Routes
@inject IRouteStorageService RouteStorage
@inject IGpxService GpxService
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Medium">

<div class="d-flex flex-grow-1 align-center gap-4 mb-3">
        <MudText Typo="Typo.h4" Class="flex-grow-1">Meine Routen</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Edge="Edge.End" Color="Color.Secondary" OnClick="@CreateNewRoute"/>
        <MudIconButton Icon="@Icons.Material.Filled.FileUpload" Edge="Edge.End" Color="Color.Primary" OnClick="@ImportGpx"/>
    </div>
    
    @if (_routes == null)
    {
        <MudProgressCircular Indeterminate="true" Class="mx-auto"/>
    }
    else if (!_routes.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-18" Elevation="4">
            <MudText Typo="Typo.body1">
                Noch keine Routen gespeichert. Erstelle eine neue Route oder importiere eine GPX-Datei.
            </MudText>
            
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (SavedRoute route in _routes)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="3">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">@route.Name</MudText>
                                <MudText Typo="Typo.caption">Erstellt: @route.CreatedAt.ToShortDateString()</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" OnClick="() => RenameRoute(route)"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteRoute(route)"/>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2"><b>Distanz:</b> @route.DistanceKm.ToString("F2") km</MudText>
                                <MudText Typo="Typo.body2"><b>Zeit:</b> @route.TimeMinutes.ToString("F0") Min</MudText>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Map"
                                       OnClick="() => NavigateToMap(route)">
                                Starten
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Default"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="() => ExportGpx(route)">
                                Export GPX
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
    </MudContainer>

@page "/settings"
@using VegaBridgeApp.Models.BLE
@using VegaBridgeApp.Models.BLE.MvAgusta
@inject BleManagerService BleManager
@inject IGeocodingService GeocodingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
<MudContainer MaxWidth="MaxWidth.Medium" Class="px-3 pt-2 pb-6">

    <MudStack Spacing="3">
        
        <!-- ── BLE Connection Hub ────────────────────────────────────── -->
        <MudCard Elevation="2" Style="border-radius: 12px;">
            <MudCardContent>
                <MudStack Spacing="3">
                    <!-- Action Buttons -->
                    <MudStack Spacing="2">
                        <MudButton 
                            Variant="Variant.Filled" 
                            Color="Color.Success"
                            OnClick="@ConnectToSelected"
                            Disabled="@(SelectedDevice == null || SelectedDevice.IsConnected || ConnectionState == BleConnectionState.Connecting)" 
                            StartIcon="@Icons.Material.Filled.ConnectWithoutContact"
                            FullWidth="true">
                            @L["Connect"]
                        </MudButton>
                        
                        <MudButton 
                            Variant="Variant.Outlined" 
                            Color="Color.Error"
                            OnClick="@Disconnect"
                            Disabled="!IsConnected" 
                            StartIcon="@Icons.Material.Filled.BluetoothDisabled"
                            FullWidth="true">
                            @L["Disconnect"]
                        </MudButton>

                        <MudButton
                            Variant="Variant.Text"
                            Color="Color.Info"
                            Size="Size.Small"
                            Disabled="!IsConnected"
                            StartIcon="@Icons.Material.Filled.Send"
                            FullWidth="true"
                            OnClick='@(async () => await BleManager.SendCommandAsync(Commands.MSG, "whatsapp", "Test from VegaBridge", "WhatsApp"))'>
                            Test MSG
                        </MudButton>

                        <!-- <MudButton
                            Variant="Variant.Outlined"
                            Color="Color.Primary"
                            Size="Size.Small"
                            Disabled="!IsConnected"
                            StartIcon="@Icons.Material.Filled.Navigation"
                            FullWidth="true"
                            OnClick="@SendNavigationTestSequenceAsync">
                            Nav Test Sequence (Standard)
                        </MudButton> -->

                        <MudButton
                            Variant="Variant.Outlined"
                            Color="Color.Secondary"
                            Size="Size.Small"
                            Disabled="!IsConnected"
                            StartIcon="@Icons.Material.Filled.Download"
                            FullWidth="true"
                            OnClick="@ExportBleLogAsync">
                            Export BLE Log
                        </MudButton>

                        <MudButton
                            Variant="Variant.Outlined"
                            Color="Color.Error"
                            Size="Size.Small"
                            Disabled="!IsConnected"
                            StartIcon="@Icons.Material.Filled.ClearAll"
                            FullWidth="true"
                            OnClick="@ClearBleLog">
                            Clear BLE Log
                        </MudButton>
                    </MudStack>

                    <MudDivider />

                    <!-- Device List Section -->
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle1">@L["DiscoveredDevices"]</MudText>
                            <MudSpacer/>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                @if (IsScanning)
                                {
                                    <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                <MudButton 
                                    OnClick="@HandleScanButtonClick" 
                                    StartIcon="@(IsScanning ? Icons.Material.Filled.Stop : Icons.Material.Filled.Refresh)" 
                                    Color="@(IsScanning ? Color.Error : Color.Info)"
                                    Variant="Variant.Text">
                                    @(IsScanning ? "Stop Scanning" : "Scan")
                                </MudButton>
                            </MudStack>
                        </MudStack>

                        <div style="max-height: 300px; overflow-y: auto;">
                            <MudList T="BleDeviceInfo" SelectedValue="@SelectedDevice" SelectedValueChanged="@(d => SelectedDevice = d)">
                                @foreach (BleDeviceInfo device in Devices)
                                {
                                    <MudListItem T="BleDeviceInfo" 
                                                 Value="@device" 
                                                 Icon="@Icons.Material.Filled.Bluetooth">
                                        <div class="d-flex flex-column" style="width: 100%;">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body1">@device.Name</MudText>
                                                @if (device.IsConnected || (SelectedDevice?.Uuid == device.Uuid && ConnectionState is BleConnectionState.Connecting or BleConnectionState.Error))
                                                {
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@GetDeviceStatusColor(device)"
                                                             Variant="Variant.Filled">
                                                        @GetDeviceStatusText(device)
                                                    </MudChip>
                                                }
                                            </div>
                                            <div class="d-flex align-center" style="margin-top: 4px;">
                                                @if (!string.IsNullOrEmpty(device.Brand))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@device.Brand</MudChip>
                                                }
                                            </div>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        </div>
                    </MudStack>
                </MudStack>
            </MudCardContent>
        </MudCard>

        <!-- ── Connection Details ──────────────────────────────────────── -->
        @if (IsConnected)
        {
            <MudCard Elevation="2" Style="border-radius: 16px;">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ConnectionDetails"]</MudText>
                    <MudText Typo="Typo.body2">Connected to <b>@SelectedDevice?.Name</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-family: monospace;">@SelectedDevice?.Uuid</MudText>
                </MudCardContent>
            </MudCard>
        }
        
        <!-- ── Navigation Settings ──────────────────────────────────────── -->
        <MudCard Elevation="2" Style="border-radius: 16px;">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-3">@L["NavSection"]</MudText>

                <MudNumericField T="double"
                                 Label="@L["OffRouteThreshold"]"
                                 Variant="Variant.Outlined"
                                 @bind-Value="_offRouteThreshold"
                                 @bind-Value:after="SaveOffRouteThreshold"
                                 Min="5" Max="200"
                                 HelperText="@L["OffRouteHelp"]"
                                 Class="mb-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["HomeSection"]</MudText>
                <MudAutocomplete T="GeoResult"
                                 Label="@L["HomeSearchLabel"]"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Home"
                                 AdornmentColor="Color.Secondary"
                                 Value="_homeLocation"
                                 ValueChanged="@OnHomeSelected"
                                 SearchFunc="@HomeSearchAsync"
                                 DebounceInterval="300"
                                 MinCharacters="2"
                                 Clearable="true"
                                 Class="mb-2" />
                @if (_homeLocation != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-1">
                        <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Home" Class="mr-1" /> @_homeLocation.Label
                    </MudChip>
                }
            </MudCardContent>
        </MudCard>

    </MudStack>

</MudContainer>

@page "/settings"
@using VegaBridgeApp.Models.BLE
@using VegaBridgeApp.Services.Closures
@inject BleManagerService BleManager
@inject IGeocodingService GeocodingService
@inject ISnackbar Snackbar
@inject GpsService Gps
@inject RoadClosureService RoadClosureService
<MudContainer MaxWidth="MaxWidth.Medium" Class="px-3 pt-2 pb-16">

    <MudStack Spacing="3">
        
        <!-- ── BLE Connection Hub ────────────────────────────────────── -->
        <MudCard Elevation="2" Style="border-radius: 12px;">
            <MudCardContent>
                <MudStack Spacing="3">
                    <!-- Action Buttons -->
                    <MudStack Spacing="2">
                        <MudButton 
                            Variant="Variant.Filled" 
                            Color="Color.Success"
                            OnClick="@ConnectToSelected"
                            Disabled="@(SelectedDevice == null || SelectedDevice.IsConnected || ConnectionState == BleConnectionState.Connecting)" 
                            StartIcon="@Icons.Material.Filled.ConnectWithoutContact"
                            FullWidth="true">
                            @L["Connect"]
                        </MudButton>
                        
                        <MudButton 
                            Variant="Variant.Outlined" 
                            Color="Color.Error"
                            OnClick="@Disconnect"
                            Disabled="!IsConnected" 
                            StartIcon="@Icons.Material.Filled.BluetoothDisabled"
                            FullWidth="true">
                            @L["Disconnect"]
                        </MudButton>
                        <MudButton
                            Variant="Variant.Text"
                            Color="Color.Info"
                            Size="Size.Small"
                            Disabled="!IsConnected"
                            StartIcon="@Icons.Material.Filled.Send"
                            FullWidth="true"
                            OnClick="@(async () => await BleManager.SendTestFrameAsync())">
                            Test Connection
                        </MudButton>

                        <!-- <MudButton
                            Variant="Variant.Outlined"
                            Color="Color.Primary"
                            Size="Size.Small"
                            Disabled="!IsConnected"
                            StartIcon="@Icons.Material.Filled.Navigation"
                            FullWidth="true"
                            OnClick="@SendNavigationTestSequenceAsync">
                            Nav Test Sequence (Standard)
                        </MudButton> -->
                        
                    </MudStack>

                    <MudDivider />

                    <!-- Device List Section -->
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle1">@L["DiscoveredDevices"]</MudText>
                            <MudSpacer/>
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                @if (IsScanning)
                                {
                                    <MudProgressCircular Color="Color.Info" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                <MudButton 
                                    OnClick="@HandleScanButtonClick" 
                                    StartIcon="@(IsScanning ? Icons.Material.Filled.Stop : Icons.Material.Filled.Refresh)" 
                                    Color="@(IsScanning ? Color.Error : Color.Info)"
                                    Variant="Variant.Text">
                                    @(IsScanning ? "Stop Scanning" : "Scan")
                                </MudButton>
                            </MudStack>
                        </MudStack>

                        <div style="max-height: 300px; overflow-y: auto;">
                            <MudList T="BleDeviceInfo" SelectedValue="@SelectedDevice" SelectedValueChanged="@(d => SelectedDevice = d)">
                                @foreach (BleDeviceInfo device in Devices)
                                {
                                    <MudListItem T="BleDeviceInfo" 
                                                 Value="@device" 
                                                 Icon="@Icons.Material.Filled.Bluetooth">
                                        <div class="d-flex flex-column" style="width: 100%;">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body1">@device.Name</MudText>
                                                @if (device.IsConnected || (SelectedDevice?.Uuid == device.Uuid && ConnectionState is BleConnectionState.Connecting or BleConnectionState.Error))
                                                {
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@GetDeviceStatusColor(device)"
                                                             Variant="Variant.Filled">
                                                        @GetDeviceStatusText(device)
                                                    </MudChip>
                                                }
                                            </div>
                                            <div class="d-flex align-center" style="margin-top: 4px;">
                                                @if (!string.IsNullOrEmpty(device.Brand))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@device.Brand</MudChip>
                                                }
                                            </div>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        </div>
                    </MudStack>
                </MudStack>
            </MudCardContent>
        </MudCard>

        <!-- ── Connection Details ──────────────────────────────────────── -->
        @if (IsConnected)
        {
            <MudCard Elevation="2" Style="border-radius: 16px;">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ConnectionDetails"]</MudText>
                    <MudText Typo="Typo.body2">@L["BLEConnectedTo", SelectedDevice?.Name ?? ""]</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-family: monospace;">@SelectedDevice?.Uuid</MudText>
                </MudCardContent>
            </MudCard>
        }
        
        <!-- ── Navigation Settings ──────────────────────────────────────── -->
        <MudCard Elevation="2" Style="border-radius: 16px;">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-3">@L["NavSection"]</MudText>

                <MudNumericField T="double"
                                 Label="@L["OffRouteThreshold"]"
                                 Variant="Variant.Outlined"
                                 @bind-Value="_offRouteThreshold"
                                 @bind-Value:after="SaveOffRouteThreshold"
                                 Min="5" Max="200"
                                 HelperText="@L["OffRouteHelp"]"
                                 Class="mb-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["HomeSection"]</MudText>
                <MudAutocomplete T="GeoResult"
                                 Label="@L["HomeSearchLabel"]"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Home"
                                 AdornmentColor="Color.Secondary"
                                 Value="_homeLocation"
                                 ValueChanged="@OnHomeSelected"
                                 SearchFunc="@HomeSearchAsync"
                                 DebounceInterval="300"
                                 MinCharacters="2"
                                 Clearable="true"
                                 Class="mb-2" />
                @if (_homeLocation != null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-1">
                        <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Home" Class="mr-1" /> @_homeLocation.Label
                    </MudChip>
                }
            </MudCardContent>
        </MudCard>

        <!-- ── Connection Test ─────────────────────────────────────────── -->
        @*<MudCard Elevation="2" Style="border-radius: 16px;">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-3">@L["LongTestTitle"]</MudText>

                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                    @L["LongTestHelp"]
                </MudText>

                @if (LongTestRunning)
                {
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="mb-3">
                        @LongTestStatusText
                    </MudText>
                    <MudProgressLinear Color="Color.Primary" Value="(double)_longTestStep / LongTestTotalSteps * 100" Class="mb-3" />
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Error"
                        StartIcon="@Icons.Material.Filled.Stop"
                        FullWidth="true"
                        OnClick="@StopLongTest">
                        @L["LongTestStop"]
                    </MudButton>
                }
                else
                {
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Timer"
                        FullWidth="true"
                        Disabled="!IsConnected"
                        OnClick="StartLongTestAsync">
                        @L["LongTestStart"]
                    </MudButton>
                }
            </MudCardContent>
        </MudCard>*@

        <!-- ── Road Closure Providers ──────────────────────────────────── -->
        <MudCard Elevation="2" Style="border-radius: 16px;">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-1">@L["ClosureProvidersTitle"]</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                    @L["ClosureProvidersHelp"]
                </MudText>

                @foreach (var provider in RoadClosureService.Providers)
                {
                    <MudSwitch T="bool"
                               Color="Color.Secondary"
                               Value="@IsProviderEnabled(provider.Key)"
                               ValueChanged="(bool v) => SetProviderEnabled(provider.Key, v)"
                               Class="mb-2">
                        @L[provider.DisplayNameResxKey]
                    </MudSwitch>
                }
            </MudCardContent>
        </MudCard>

        <!-- ── Debug Logging ─────────────────────────────────────────────── -->
        <MudCard Elevation="2" Style="border-radius: 16px;">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-3">@L["DebugSection"]</MudText>

                <MudSwitch T="bool"
                           Color="Color.Secondary"
                           Value="@DebugLoggingEnabled"
                           ValueChanged="(bool v) => SetDebugLogging(v)"
                           Class="mb-3">
                    @L["DebugLoggingToggle"]
                </MudSwitch>

                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 pb-2">
                    @L["DebugLoggingHelp"]
                </MudText>

                <MudStack Spacing="2">
                    <MudButton
                        Variant="Variant.Outlined"
                        Color="Color.Secondary"
                        Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.FileDownload"
                        FullWidth="true"
                        Disabled="!DebugLoggingEnabled"
                        OnClick="@ExportDebugLog">
                        @L["DebugExportLog"]
                    </MudButton>

                    <MudButton
                        Variant="Variant.Outlined"
                        Color="Color.Error"
                        Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.ClearAll"
                        FullWidth="true"
                        Disabled="!DebugLoggingEnabled"
                        OnClick="@ClearDebugLog">
                        @L["DebugClearLog"]
                    </MudButton>
                    
                </MudStack>
            </MudCardContent>
            
        </MudCard>

    </MudStack>

</MudContainer>

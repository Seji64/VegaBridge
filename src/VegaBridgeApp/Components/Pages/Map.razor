@page "/map"
@page "/map/{routeId}"
@using VegaBridgeApp.Models.Utils
@using VegaBridgeApp.Services.Routes
@using VegaBridgeApp.Services.Navigation
@using VegaBridgeApp.Services.Closures
@inject IGeocodingService GeocodingService
@inject IValhallaClient ValhallaClient
@inject IRouteStorageService RouteStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject GpsService Gps
@inject NavigationService NavService
@inject IRoadClosureService RoadClosureService


<MudContainer Class="px-0 mx-0 pb-0 mb-0" Style="max-width: none; width: 100%;">
    <div style="position: relative; min-height: 100vh; width: 100%;">
        
        <!-- Layer 0: Map (Background) -->
        <div style="position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%;">
            <OpenStreetMap @ref="_map"
                           InteractionsEnabled="@(!_isLoading)"
                           ZoomControl="false" OnRenderComplete="@(() => _mapLoaded = true)"
                           ZoomChanged="OnMapZoomChanged"
                           OnClick="OnMapClick"
                           OnMarkerClick="OnMarkerClick">
            </OpenStreetMap>
        </div>

        <!-- Layer 1: UI Overlays -->
        <div style="position: absolute; inset: 0; z-index: 10; pointer-events: none;">
            
            @if (NavService.IsNavigating)
            {
                <NavigationHud Maneuver="@_navManeuver"
                               Status="@_navStatus"
                               TotalDistanceKm="@(_navTotalKm ?? NavService.TotalDistanceKm)"
                               ClosureCheckRunning="@_closureCheckRunning"
                               GpsAccuracyM="@Gps.CurrentAccuracy"/>
            }

            @if (!NavService.IsNavigating)
            {
                <!-- Route Planning Panel -->
                <MudPaper Elevation="0"
                          Square="true"
                          Class="pa-4"
                          Style="position: absolute; top: 0; left: 0; right: 0; z-index: 150; pointer-events: auto; max-width: 500px; margin: 0 auto;">

                    @if (Gps.IsTracking)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="mr-2">
                                <MudText Typo="Typo.caption">GPS @FormatCoordinate(Gps.LastReading?.Position.Latitude, Gps.LastReading?.Position.Longitude)</MudText>
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                <MudText Typo="Typo.caption">@string.Format(L["Kmh"], Gps.CurrentSpeedKmh)</MudText>
                            </MudChip>
                            <MudText Typo="Typo.caption" Class="text-medium-emphasis ml-auto">@string.Format(L["Accuracy"], Gps.CurrentAccuracy)</MudText>
                        </MudStack>
                    }

                    <div style="overflow-y: auto; max-height: 180px;" class="pr-2">

                        <AddressAutocomplete Label="@L["Start"]"
                                             AdornmentIcon="@Icons.Material.Filled.Home"
                                             Class="mb-3"
                                             @bind-Value="_startLocation"
                                             SearchFunc="@SearchAsync"
                                             Pins="@GetPinnedStartLocations()"/>


                        @foreach ((WaypointViewModel waypoint, int index) in _waypoints.Select((wp, i) => (wp, i)))
                        {
                            <MudStack Row="true">

                                <AddressAutocomplete @key="waypoint.Id"
                                                     Label="@L["Waypoint"]"
                                                     AdornmentIcon="@Icons.Material.Filled.WrongLocation"
                                                     AdornmentColor="Color.Error"
                                                     OnAdornmentClick="@(() => RemoveWaypointAsync(index))"
                                                     Class="mb-3"
                                                     MinCharacters="3"
                                                     Value="waypoint.Location"
                                                     ValueChanged="@(val => OnWaypointChanged(waypoint, val))"
                                                     SearchFunc="@SearchAsync"
                                                     Pins="@GetPinnedStartLocations()"/>

                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                               Size="Size.Small"
                                               OnClick="() => MoveWaypointAsync(waypoint, -1)"
                                               Disabled="@(index == 0)"/>

                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                               Size="Size.Small"
                                               OnClick="() => MoveWaypointAsync(waypoint, 1)"
                                               Disabled="@(index == _waypoints.Count - 1)"/>

                            </MudStack>
                        }

                        <MudPaper Class="border-dashed border-2 pa-2 mb-4" Elevation="0">
                            <MudStack Row="true" AlignItems="AlignItems.Center">
                                <MudIconButton Class="ml-1" Size="Size.Small" Icon="@Icons.Material.Outlined.AddLocation" OnClick="@AddWaypoint"></MudIconButton>
                                <MudText Typo="Typo.body1" Class="mud-text-disabled">@L["AddWaypoint"]</MudText>
                            </MudStack>
                        </MudPaper>

                        <AddressAutocomplete Label="@L["Destination"]"
                                             AdornmentIcon="@Icons.Material.Filled.Place"
                                             Class="mb-3"
                                             @bind-Value="_destinationLocation"
                                             SearchFunc="@SearchAsync"
                                             Pins="@GetPinnedStartLocations()"/>

                    </div>
                    
                    <!-- Route options: road types to avoid -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Avoid"]</MudText>
                        <MudChipSet T="RoadAvoidance"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    SelectedValues="@_avoidSelection"
                                    SelectedValuesChanged="@OnAvoidSelectionChanged"
                                    CheckMark="true"
                                    Size="Size.Small"
                                    Variant="Variant.Outlined"
                                    SelectedColor="Color.Primary"
                                    Disabled="@(_isLoading || _closureCheckRunning)">
                            <MudChip Value="RoadAvoidance.Highways" Text="@L["AvoidHighways"]"/>
                            <MudChip Value="RoadAvoidance.Tolls" Text="@L["AvoidTolls"]"/>
                            <MudChip Value="RoadAvoidance.Ferries" Text="@L["AvoidFerries"]"/>
                        </MudChipSet>
                    </MudStack>
                    
                    <MudDivider Class="mt-2 mb-2" />

                    <MudLoadingButton FullWidth="true"
                                      Class="mt-2"
                                      Variant="Variant.Filled"
                                      Color="Color.Primary"
                                      StartIcon="@Icons.Material.Filled.Start"
                                      Disabled="@(_startLocation is null || _destinationLocation is null || _waypoints.Any(x => x.Location is null))"
                                      Loading="@(_isLoading || _closureCheckRunning)"
                                      OnClick="@CalculateRoute">
                        @L["CalculateRoute"]
                    </MudLoadingButton>

                    <!-- Route summary: length and approximate riding time -->
                    @if (_currentRouteResponse?.Trip?.Summary is { } summary)
                    {
                        <MudPaper Outlined="true" Class="d-flex justify-space-around align-center flex-wrap gap-2 mt-2 px-2 py-1">
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Straighten" Color="Color.Primary" Size="Size.Small"/>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@string.Format(L["Km"], summary.Length)</MudText>
                            </div>
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" Size="Size.Small"/>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@string.Format(L["RouteDurationApprox"], L.FormatDuration(summary.Time / 60.0))</MudText>
                            </div>
                        </MudPaper>
                    }

                    @if (_currentRouteResponse != null)
                    {
                        <MudButton FullWidth="true"
                                   Class="mt-2"
                                   Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Navigation"
                                   OnClick="@StartNavigation">
                            @L["StartNavigation"]
                        </MudButton>

                        <MudLoadingButton FullWidth="true"
                                          Class="mt-2"
                                          Variant="Variant.Outlined"
                                          Color="Color.Secondary"
                                          StartIcon="@Icons.Material.Filled.Save"
                                          bind-Loading="@_isSaving"
                                          OnClick="@SaveCurrentRoute">
                            @L["SaveRoute"]
                        </MudLoadingButton>
                    }

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true">
                            @_errorMessage
                        </MudAlert>
                    }

                </MudPaper>
            }
            
            <!-- Map buttons (bottom right): navigation actions above the
                 always visible my-location button. -->
            <div class="d-flex flex-column align-center gap-4"
                 style="position: absolute; bottom: 150px; right: 16px; z-index: 200; pointer-events: auto;">
                @if (NavService.IsNavigating)
                {
                    @if (HasWaypointToSkip)
                    {
                        <MudFab Color="Color.Secondary"
                                StartIcon="@Icons.Material.Filled.SkipNext"
                                Size="Size.Medium"
                                title="@L["SkipWaypoint"]"
                                OnClick="@SkipWaypoint"/>
                    }

                    <MudFab Color="Color.Error"
                            StartIcon="@Icons.Material.Filled.Close"
                            Size="Size.Medium"
                            title="@L["StopNavigationFab"]"
                            OnClick="@ConfirmExitNavigation"/>
                }

                <MudFab Color="@(Gps.IsTracking ? Color.Primary : Color.Surface)"
                        StartIcon="@(Gps.IsTracking ? Icons.Material.Filled.MyLocation : Icons.Material.Outlined.MyLocation)"
                        Size="@(NavService.IsNavigating ? Size.Medium : Size.Small)"
                        OnClick="@GetMyCurrentPosition"/>
            </div>
        </div>
    </div>
</MudContainer>
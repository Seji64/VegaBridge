@* Navigation HUD: next maneuver + trip info, floating over the map.
   Display only – touches go through to the map. *@
<div class="pa-2">
    @if (Maneuver != null || Status != null)
    {
        <MudPaper Elevation="4" Class="overflow-hidden" Style="border-radius: 16px;">
            @if (Maneuver != null)
            {
                <!-- Next maneuver: arrow, distance, instruction -->
                <div class="mud-theme-primary d-flex align-center gap-4 px-4 py-3">
                    <div style="position: relative; flex-shrink: 0; line-height: 0;">
                        <MudIcon Icon="@TurnIcon" Style="font-size: 3.5rem;"/>
                        @if (Maneuver.RoundaboutExitCount is > 0)
                        {
                            <!-- Roundabout: which exit -->
                            <span class="d-flex align-center justify-center"
                                  style="position: absolute; right: -8px; bottom: -6px; min-width: 26px; height: 26px; padding: 0 6px; border-radius: 13px; font-size: 0.95rem; font-weight: 700; line-height: 1; background: var(--mud-palette-dark); color: var(--mud-palette-dark-text);">
                                @RoundaboutExitText
                            </span>
                        }
                    </div>
                    <div style="min-width: 0;">
                        <MudText Style="font-size: 2.25rem; font-weight: 700; line-height: 1.1;">
                            @L.FormatTurnDistance(Status?.DistanceToNextTurnM)
                        </MudText>
                        <MudText Typo="Typo.subtitle1"
                                 Style="font-size: 1.1rem; font-weight: 500; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(Maneuver.Instruction) ? TurnLabel : Maneuver.Instruction)
                        </MudText>
                    </div>
                </div>
            }

            @if (Status != null)
            {
                <!-- Trip info + progress along the route (by distance) -->
                <div class="d-flex justify-space-around align-start px-2 py-2">
                    <div class="d-flex flex-column align-center">
                        <MudText Style="font-size: 1.2rem; font-weight: 700;">@DisplayFormat.FormatArrivalTime(Status.RemainingTimeMin)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["NavEta"]</MudText>
                    </div>
                    <div class="d-flex flex-column align-center">
                        <MudText Style="font-size: 1.2rem; font-weight: 700;">@L.FormatDuration(Status.RemainingTimeMin)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["NavRemainingTime"]</MudText>
                    </div>
                    <div class="d-flex flex-column align-center">
                        <MudText Style="font-size: 1.2rem; font-weight: 700;">@string.Format(L["Km"], Status.RemainingDistanceKm)</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["NavRemainingDistance"]</MudText>
                    </div>
                </div>
                <MudProgressLinear Value="@ProgressPercent" Color="Color.Primary" Size="Size.Small"/>
            }
        </MudPaper>
    }

    <!-- Status hints below the HUD -->
    <div class="d-flex flex-wrap gap-2 mt-2">
        @if (ClosureCheckRunning)
        {
            <MudPaper Elevation="3" Class="d-flex align-center gap-2 px-3 py-1" Style="border-radius: 12px;">
                <MudProgressCircular Color="Color.Warning" Size="Size.Small" Indeterminate="true"/>
                <MudText Typo="Typo.body2">@L["ClosureCheckRunning"]</MudText>
            </MudPaper>
        }
        @if (GpsAccuracyM > GpsIgnoredAccuracyM)
        {
            <MudPaper Elevation="3" Class="d-flex align-center gap-2 px-3 py-1" Style="border-radius: 12px;">
                <MudIcon Icon="@Icons.Material.Filled.GpsNotFixed" Color="Color.Warning" Size="Size.Small"/>
                <MudText Typo="Typo.body2">@string.Format(L["NavGpsWeak"], GpsAccuracyM)</MudText>
            </MudPaper>
        }
    </div>
</div>

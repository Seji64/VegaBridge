<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle1">@Location?.Label</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@FormatCoordinate(Location?.Latitude, Location?.Longitude)</MudText>
            <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.EditLocation"
                       OnClick="Move">
                @L["MoveWaypoint"]
            </MudButton>
            <MudButton FullWidth="true" Size="Size.Large" Variant="Variant.Filled" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="Delete">
                @L["DeleteWaypoint"]
            </MudButton>
            <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Cancel"]</MudButton>
        </MudStack>
    </DialogContent>
</MudDialog>

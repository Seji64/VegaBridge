<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["GpxExportTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            @L["GpxExportPrompt"]
        </MudText>

        <MudRadioGroup T="string" @bind-Value="_choice">
            <MudStack Spacing="2">
                <MudRadio Value="@("track")" Color="Color.Primary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@L["GpxExportTrackTag"]</MudText>
                        <MudText Typo="Typo.caption">@L["GpxExportTrackDesc"]</MudText>
                    </MudStack>
                </MudRadio>
                <MudRadio Value="@("route")" Color="Color.Primary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@L["GpxExportRouteTag"]</MudText>
                        <MudText Typo="Typo.caption">@L["GpxExportRouteDesc"]</MudText>
                    </MudStack>
                </MudRadio>
            </MudStack>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
            @L["Export"]
        </MudButton>
    </DialogActions>
</MudDialog>

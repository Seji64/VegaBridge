<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">GPX exportieren</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">
            In welchem Format möchtest du die Route exportieren?
        </MudText>

        <MudRadioGroup T="string" @bind-Value="_choice">
            <MudStack Spacing="2">
                <MudRadio Value="@("track")" Color="Color.Primary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Track (&lt;trk&gt;)</MudText>
                        <MudText Typo="Typo.caption">Standard-Format – Waypoints als aufgezeichnete Spur</MudText>
                    </MudStack>
                </MudRadio>
                <MudRadio Value="@("route")" Color="Color.Primary">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">Route (&lt;rte&gt;)</MudText>
                        <MudText Typo="Typo.caption">Geplante Route – Waypoints als Routenpunkte</MudText>
                    </MudStack>
                </MudRadio>
            </MudStack>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
            Exportieren
        </MudButton>
    </DialogActions>
</MudDialog>

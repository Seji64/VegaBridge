<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- The app project only builds for iOS/Android, so the navigation core and
         the BLE plugin contract are compiled in directly (no MAUI/Shiny
         dependencies). -->
    <ItemGroup>
        <Compile Include="../VegaBridgeApp/Services/Navigation/*.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/BLE/IBleDevicePlugin.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/BLE/IBleConnectedDevice.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/BLE/Plugins/*.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Location/GpsService.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Location/GpsDelegate.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Valhalla/*.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Routes/PolylineEncoder.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Geocoding/*.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Models/**/*.cs" Link="App/Models/%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Utils/*.cs" Link="App/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NSubstitute" Version="6.2.0" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Shiny.Locations" Version="5.9.0" />
        <PackageReference Include="Flurl.Http" Version="4.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    </ItemGroup>

</Project>

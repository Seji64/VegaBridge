<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- The app project only builds for iOS/Android, so the navigation core is
         compiled in directly (it has no MAUI dependencies). -->
    <ItemGroup>
        <Compile Include="../VegaBridgeApp/Services/Navigation/*.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Location/GpsService.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Location/GpsDelegate.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Valhalla/IValhallaClient.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Services/Routes/PolylineEncoder.cs" Link="App/%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Models/**/*.cs" Link="App/Models/%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="../VegaBridgeApp/Utils/*.cs" Link="App/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageReference Include="NSubstitute" Version="5.3.0" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Shiny.Locations" Version="5.9.0" />
    </ItemGroup>

</Project>
